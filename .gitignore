# =====================================================================
# .gitignore — TeachHub PT
# ไม่นำข้อมูลจริงขึ้น Git: ไฟล์ที่ผู้ใช้อัปโหลด ไฟล์สำรองข้อมูล และไฟล์ชั่วคราว
# =====================================================================

# ไฟล์ที่ผู้ใช้อัปโหลด (เก็บไว้เฉพาะไฟล์ป้องกันในแต่ละโฟลเดอร์)
uploads/**
!uploads/
!uploads/*/
!uploads/.htaccess
!uploads/index.html
!uploads/*/index.html
uploads/backups/*.zip

# ไฟล์ log / ชั่วคราว / ระบบปฏิบัติการ / editor
*.log
*.tmp
*.bak
~$*
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ค่าเชื่อมต่อฐานข้อมูลของเครื่องจริง (ถ้าสร้างแยก)
config/db.local.php

# token ของ Google Drive (v1.18) — สร้างโดยระบบเมื่อเชื่อมต่อ ห้ามนำขึ้น Git
config/drive_token.php
.env
