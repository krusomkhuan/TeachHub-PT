# ไฟล์: database/.htaccess — ไฟล์ SQL (โครงสร้างฐานข้อมูล/อัปเดต/ข้อมูลตัวอย่าง) ห้ามดาวน์โหลดผ่านเว็บ
# นำเข้าผ่าน phpMyAdmin จากเครื่องของผู้ดูแลเท่านั้น
Options -Indexes
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
