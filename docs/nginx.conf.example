# =====================================================================
# ตัวอย่างการตั้งค่า Nginx สำหรับ TeachHub PT
# (ใช้เฉพาะเซิร์ฟเวอร์ Nginx — Nginx ไม่อ่านไฟล์ .htaccess จึงต้องกำหนดกฎความปลอดภัยที่นี่)
# แก้ server_name, root และ fastcgi_pass ให้ตรงกับเซิร์ฟเวอร์ของท่าน
# =====================================================================
server {
    listen 80;
    server_name teachhub.example.ac.th;
    root /var/www/teachhub_pt;
    index index.php;
    charset utf-8;

    client_max_body_size 40M;          # ต้อง >= ขนาดไฟล์สูงสุดที่ตั้งในระบบ

    # ห้ามเข้าถึงโฟลเดอร์/ไฟล์สำคัญโดยตรง
    location ^~ /uploads/  { deny all; return 403; }
    location ^~ /config/   { deny all; return 403; }
    location ^~ /includes/ { deny all; return 403; }
    location ^~ /docs/     { deny all; return 403; }
    location ~ /\.          { deny all; return 403; }      # .htaccess .user.ini .git
    location ~* \.(sql|md|log|ini|bak)$ { deny all; return 403; }

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_read_timeout 120;
    }
}
